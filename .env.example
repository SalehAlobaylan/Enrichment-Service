# ─── Server ───────────────────────────────────────────
PORT=5050
ENV=development
LOG_LEVEL=info
WORKERS=1

# ─── Auth ─────────────────────────────────────────────
SERVICE_AUTH_TOKEN=your-enrichment-service-token
CMS_SERVICE_TOKEN=your-cms-service-token
CMS_BASE_URL=http://localhost:8080

# ─── Models — text embedder + reranker. Whisper + CLIP moved to Media-Service.
# BGE-M3: multilingual (Arabic + English), 1024-dim dense + sparse.
# bge-reranker-v2-m3: cross-encoder for /v1/feed/news/slide.
# Combined ~6 GB RAM with use_fp16=True (default); ~90-120s cold start.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MODELS_DIR=./models

# ─── Circuit Breaker (CMS write-back) ────────────────
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SEC=30
CB_HALF_OPEN_REQUESTS=3

# ─── LLM ─────────────────────────────────────────────
# Provider: gemini (primary) | deepseek (fallback) | openai | anthropic | none
#
# Default chain: gemini-3.5-flash → deepseek-chat
#   - Gemini 3.5 Flash: cheap, capable, strong on Arabic translate/summarize.
#   - DeepSeek: OpenAI-compatible API (base URL https://api.deepseek.com/v1),
#     cost-effective fallback that avoids single-vendor risk during Gemini outages.
#
# openai + anthropic stay supported so ops can switch quickly if both
# Gemini and DeepSeek have an outage — but they're not in the default chain.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_PROVIDERS=deepseek

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Per-provider model overrides (optional). DeepSeek has a real default
# because the primary LLM_MODEL is typically a Gemini model name that
# DeepSeek wouldn't accept.
# LLM_GEMINI_MODEL=gemini-3.5-flash
LLM_DEEPSEEK_MODEL=deepseek-chat
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Timeouts ────────────────────────────────────────
EXTRACT_TIMEOUT_SEC=30
CMS_REQUEST_TIMEOUT_SEC=10

# ─── Redis — LLM response cache only (db=1). ─────────
# arq async queue (db=2) lives in Media-Service now.
REDIS_URL=redis://localhost:6379
LLM_CACHE_DB=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SEC=604800

# ─── Feature toggles ─────────────────────────────────
# Cross-encoder reranker for /v1/related + /v1/feed/news/slide.
# Disable only for debugging the RRF-only retrieval path.
RERANK_ENABLED=true

# ─── Retrieval tuning — NOT in env ───────────────────
# RRF_K, RELATED_K_DENSE_DEFAULT, RELATED_K_SPARSE_DEFAULT, RERANK_INPUT_K,
# FRESHNESS_DECAY_*_DAYS, NEWS_MAX_PER_SOURCE — these are tunable knobs
# (not boot-time infrastructure), so they live as code defaults in
# src/common/config.py. To change at runtime use the Platform-Console
# "Retrieval Tuning" admin page (planned). Env overrides still work as an
# emergency escape hatch but are deliberately undocumented to discourage
# operator config sprawl.
