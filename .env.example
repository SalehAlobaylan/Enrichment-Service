# ─── Server ───────────────────────────────────────────
PORT=5050
ENV=development
LOG_LEVEL=info
WORKERS=1

# ─── Auth ─────────────────────────────────────────────
SERVICE_AUTH_TOKEN=your-enrichment-service-token
CMS_SERVICE_TOKEN=your-cms-service-token
CMS_BASE_URL=http://localhost:8080

# ─── Models — text embedder only. Whisper + CLIP moved to Media-Service.
# BGE-M3: multilingual (Arabic + English), 1024-dim dense.
# Runs at ~3 GB RAM with use_fp16=True (default); ~60-90s cold start.
EMBEDDING_MODEL=BAAI/bge-m3
MODELS_DIR=./models

# ─── Circuit Breaker (CMS write-back) ────────────────
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SEC=30
CB_HALF_OPEN_REQUESTS=3

# ─── LLM ─────────────────────────────────────────────
# Provider: openai | anthropic | gemini | none
# Examples per provider:
#   openai    + gpt-4o-mini, gpt-4o
#   anthropic + claude-haiku-4-5-20251001, claude-sonnet-4-6
#   gemini    + gemini-3.1-flash, gemini-3.1-pro, gemini-2.0-flash
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Timeouts ────────────────────────────────────────
EXTRACT_TIMEOUT_SEC=30
CMS_REQUEST_TIMEOUT_SEC=10

# ─── Redis — LLM response cache only (db=1). ─────────
# arq async queue (db=2) lives in Media-Service now.
REDIS_URL=redis://localhost:6379
LLM_CACHE_DB=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SEC=604800
