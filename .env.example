# ─── Server ───────────────────────────────────────────
PORT=5050
ENV=development
LOG_LEVEL=info
WORKERS=1

# ─── Auth ─────────────────────────────────────────────
SERVICE_AUTH_TOKEN=your-enrichment-service-token
CMS_SERVICE_TOKEN=your-cms-service-token
CMS_BASE_URL=http://localhost:8080

# ─── Models ───────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODELS_DIR=./models

# ─── Circuit Breaker ─────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SEC=30
CB_HALF_OPEN_REQUESTS=3

# ─── LLM ─────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Timeouts ────────────────────────────────────────
TRANSCRIBE_TIMEOUT_SEC=600
EXTRACT_TIMEOUT_SEC=30
CMS_REQUEST_TIMEOUT_SEC=10
